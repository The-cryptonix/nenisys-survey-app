# Base URL of the survey backend (no trailing slash). Example only; set the real value in Vercel.
VITE_API_BASE_URL=https://api.example.com

# Cloudflare Turnstile site key (public, safe to expose). Create a widget in the Cloudflare dashboard and
# allow this app's hostnames. The matching secret key goes in the BACKEND only (TURNSTILE_SECRET_KEY).
# For testing, Cloudflare's always-pass dummy site key is 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
